{#-
  Managed by Salt - formula: salt - state: exporter - instance: {{ instance_name }}

  This is sourced by systemd (EnvironmentFile=) before ExecStart. It is
  the mechanism for exposing every CLI flag through pillar without baking
  any of them into the unit file itself:

    salt:
      exporter:
        instances:
          default:
            extra_args:
              - "-health-minions=false"
            env:
              SALT_EXPORTER_LOG_LEVEL: "info"

  `extra_args` becomes $EXPORTER_EXTRA_ARGS, appended verbatim to
  ExecStart. Anything under `env` is exported as-is - use it for flags the
  binary also accepts as environment variables (see `salt-exporter -help`
  for the current flag/env-var list for your installed version).
#}
EXPORTER_EXTRA_ARGS={{ instance.get('extra_args', []) | join(' ') }}
{% for key, value in instance.get('env', {}).items() -%}
{{ key }}={{ value }}
{% endfor -%}
