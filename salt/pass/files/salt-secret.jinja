#!/usr/bin/env bash
set -euo pipefail

readonly STORE_USER={{ sp.user | quote }}
readonly GPG_HOME={{ sp.gpg_home | quote }}
readonly STORE_DIR={{ sp.store_dir | quote }}

usage() {
  cat <<'EOF'
Usage:
  salt-secret NAME
  salt-secret add NAME
  salt-secret add --force NAME
  salt-secret edit NAME
  salt-secret generate NAME [LENGTH]
  salt-secret list [PREFIX]
  salt-secret remove NAME
  salt-secret show NAME

Names use slash-separated components, for example:
  applications/webmail/database_password

Passing NAME without a command is shorthand for "add NAME". Input is hidden
and pass asks for confirmation. Use --force only when replacing an entry.

"add" accepts one line. "edit" opens EDITOR (or vi), creates NAME when it does
not exist, and supports multiline text such as private keys and certificates.

"show" deliberately prints a secret. Avoid using it in scripts or captured logs.
EOF
}

die() {
  printf 'salt-secret: %s\n' "$*" >&2
  exit 2
}

valid_name() {
  [[ "$1" =~ ^[A-Za-z0-9._@+-]+(/[A-Za-z0-9._@+-]+)*$ ]] || return 1
  [[ "/$1/" != *"/../"* && "/$1/" != *"/./"* ]]
}

run_pass() {
  if [[ "$(id -un)" == "$STORE_USER" ]]; then
    env GNUPGHOME="$GPG_HOME" PASSWORD_STORE_DIR="$STORE_DIR" pass "$@"
  elif [[ "$(id -u)" -eq 0 ]]; then
    runuser -u "$STORE_USER" -- env \
      GNUPGHOME="$GPG_HOME" PASSWORD_STORE_DIR="$STORE_DIR" pass "$@"
  else
    die "run as root or $STORE_USER"
  fi
}

insert_secret() {
  local name=$1
  local overwrite=${2:-false}
  local args=(insert)

  if [[ "$overwrite" == true ]]; then
    args+=(--force)
  elif [[ -e "$STORE_DIR/$name.gpg" ]]; then
    die "credential already exists; use 'add --force $name' to replace it"
  fi
  run_pass "${args[@]}" "$name"
}

[[ $# -ge 1 ]] || { usage; exit 2; }
command_name=$1
shift

case "$command_name" in
  add)
    overwrite=false
    if [[ ${1:-} == '--force' ]]; then
      overwrite=true
      shift
    fi
    [[ $# -eq 1 ]] || die 'add requires [--force] NAME'
    valid_name "$1" || die 'invalid credential name'
    insert_secret "$1" "$overwrite"
    ;;
  edit)
    [[ $# -eq 1 ]] || die 'edit requires NAME'
    valid_name "$1" || die 'invalid credential name'
    run_pass edit "$1"
    ;;
  generate)
    [[ $# -ge 1 && $# -le 2 ]] || die 'generate requires NAME [LENGTH]'
    valid_name "$1" || die 'invalid credential name'
    length=${2:-32}
    [[ "$length" =~ ^[1-9][0-9]*$ ]] || die 'length must be a positive integer'
    # --no-symbols is friendlier to applications with restrictive password parsers.
    run_pass generate --no-symbols "$1" "$length"
    ;;
  list)
    [[ $# -le 1 ]] || die 'list accepts at most one PREFIX'
    if [[ $# -eq 1 ]]; then
      valid_name "$1" || die 'invalid prefix'
      run_pass ls "$1"
    else
      run_pass ls
    fi
    ;;
  remove)
    [[ $# -eq 1 ]] || die 'remove requires NAME'
    valid_name "$1" || die 'invalid credential name'
    run_pass rm "$1"
    ;;
  show)
    [[ $# -eq 1 ]] || die 'show requires NAME'
    valid_name "$1" || die 'invalid credential name'
    run_pass show "$1"
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    if [[ $# -eq 0 ]] && valid_name "$command_name"; then
      insert_secret "$command_name"
    else
      usage >&2
      die "unknown command: $command_name"
    fi
    ;;
esac
